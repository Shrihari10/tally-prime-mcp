# Tally Prime XML/HTTP gateway configuration
# Enable in Tally: F1 (Help) > Settings > Connectivity > Client/Server configuration
# Set TallyPrime acts as = Server, Port = 9000
TALLY_HOST=localhost
TALLY_PORT=9000

# Optional default company (skip to use the currently active company in Tally)
# TALLY_COMPANY=ABC Company Pvt Ltd

# Request timeout in milliseconds (default 60000)
# TALLY_TIMEOUT_MS=60000
